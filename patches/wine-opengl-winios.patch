+    if (enabled < 0)
+    {
+        const char *env = getenv( "MADEIRA_GL_QUERY_BUFFER_OFFSETS" );
+        enabled = !(env && env[0] == '0');
+    }
+    if (!enabled) return ios_wow_host_ptr( value );
+#endif
+    /* Guest memory never lies in the first 64 KB: smaller values are offsets. */
