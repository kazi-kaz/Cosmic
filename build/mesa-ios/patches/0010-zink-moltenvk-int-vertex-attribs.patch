+/* Madeira: Metal refuses a pipeline whose vertex shader reads an integer input
+ * from a float, normalized or scaled vertex format ("Cannot convert attribute
+ * from MTLAttributeFormatFloat to int1 or uint1", Vintage Story through
+ * MoltenVK), and Zink then skips every draw that uses it. GL leaves the value
+ * undefined and desktop drivers read the data anyway. Such an attribute gets
+ * the integer format with the same channels and channel size: normalized and
+ * scaled formats keep their own signedness and give the stored integers;
+ * float formats take the shader's signedness and give their bits.
+ *
+ * MADEIRA_ZINK_INT_ATTRIBS=0 turns this off; =1 also turns it on for drivers
+ * other than MoltenVK.
+ */
+static VkFormat
+madeira_int_vertex_format(VkFormat format, bool is_signed)
+{
+#define MADEIRA_INT_FMT(f, s, u) case f: return is_signed ? s : u;
+#define MADEIRA_INT_FMTS(prefix, s, u) \
+   case VK_FORMAT_##prefix##_UNORM: case VK_FORMAT_##prefix##_USCALED: return u; \
+   case VK_FORMAT_##prefix##_SNORM: case VK_FORMAT_##prefix##_SSCALED: return s;
+   switch (format) {
+   MADEIRA_INT_FMTS(R8, VK_FORMAT_R8_SINT, VK_FORMAT_R8_UINT)
+   MADEIRA_INT_FMTS(R8G8, VK_FORMAT_R8G8_SINT, VK_FORMAT_R8G8_UINT)
+   MADEIRA_INT_FMTS(R8G8B8, VK_FORMAT_R8G8B8_SINT, VK_FORMAT_R8G8B8_UINT)
+   MADEIRA_INT_FMTS(R8G8B8A8, VK_FORMAT_R8G8B8A8_SINT, VK_FORMAT_R8G8B8A8_UINT)
+   MADEIRA_INT_FMTS(R16, VK_FORMAT_R16_SINT, VK_FORMAT_R16_UINT)
+   MADEIRA_INT_FMTS(R16G16, VK_FORMAT_R16G16_SINT, VK_FORMAT_R16G16_UINT)
+   MADEIRA_INT_FMTS(R16G16B16, VK_FORMAT_R16G16B16_SINT, VK_FORMAT_R16G16B16_UINT)
+   MADEIRA_INT_FMTS(R16G16B16A16, VK_FORMAT_R16G16B16A16_SINT, VK_FORMAT_R16G16B16A16_UINT)
+   MADEIRA_INT_FMT(VK_FORMAT_R16_SFLOAT, VK_FORMAT_R16_SINT, VK_FORMAT_R16_UINT)
+   MADEIRA_INT_FMT(VK_FORMAT_R16G16_SFLOAT, VK_FORMAT_R16G16_SINT, VK_FORMAT_R16G16_UINT)
+   MADEIRA_INT_FMT(VK_FORMAT_R16G16B16_SFLOAT, VK_FORMAT_R16G16B16_SINT, VK_FORMAT_R16G16B16_UINT)
+   MADEIRA_INT_FMT(VK_FORMAT_R16G16B16A16_SFLOAT, VK_FORMAT_R16G16B16A16_SINT, VK_FORMAT_R16G16B16A16_UINT)
+   MADEIRA_INT_FMT(VK_FORMAT_R32_SFLOAT, VK_FORMAT_R32_SINT, VK_FORMAT_R32_UINT)
+   MADEIRA_INT_FMT(VK_FORMAT_R32G32_SFLOAT, VK_FORMAT_R32G32_SINT, VK_FORMAT_R32G32_UINT)
+   MADEIRA_INT_FMT(VK_FORMAT_R32G32B32_SFLOAT, VK_FORMAT_R32G32B32_SINT, VK_FORMAT_R32G32B32_UINT)
+   MADEIRA_INT_FMT(VK_FORMAT_R32G32B32A32_SFLOAT, VK_FORMAT_R32G32B32A32_SINT, VK_FORMAT_R32G32B32A32_UINT)
+   default:
+      return VK_FORMAT_UNDEFINED;
+   }
+#undef MADEIRA_INT_FMTS
+#undef MADEIRA_INT_FMT
+}
+
+/* the attribute list for the pipeline: 'state' itself, or 'out' with integer
+ * formats where the vertex shader reads an integer
+ */
+static const VkVertexInputAttributeDescription *
+madeira_int_vertex_attribs(struct zink_screen *screen, const struct zink_gfx_program *prog,
+                           const struct zink_vertex_elements_hw_state *state,
+                           VkVertexInputAttributeDescription *out)
+{
+   static int enabled = -1;
+   static unsigned logged;
+   if (enabled < 0) {
+      const char *env = getenv("MADEIRA_ZINK_INT_ATTRIBS");
+      enabled = env && *env ? strcmp(env, "0") != 0 :
+                screen->info.driver_props.driverID == VK_DRIVER_ID_MOLTENVK;
+   }
+   const struct zink_shader *vs = prog ? prog->shaders[MESA_SHADER_VERTEX] : NULL;
+   if (!enabled || !vs || !(vs->madeira_vs_int_inputs | vs->madeira_vs_uint_inputs))
+      return state->attribs;
+
+   bool changed = false;
+   for (unsigned i = 0; i < state->num_attribs && i < PIPE_MAX_ATTRIBS; i++) {
+      out[i] = state->attribs[i];
+      const unsigned loc = out[i].location;
+      if (loc >= 32)
+         continue;
+      const bool is_signed = vs->madeira_vs_int_inputs & BITFIELD_BIT(loc);
+      if (!is_signed && !(vs->madeira_vs_uint_inputs & BITFIELD_BIT(loc)))
+         continue;
+      const VkFormat format = madeira_int_vertex_format(out[i].format, is_signed);
+      if (format == VK_FORMAT_UNDEFINED)
+         continue;
+      if (logged < 8) {
+         logged++;
+         mesa_logw("[zink-madeira] vertex input %u: format %d read as integer format %d for an %s shader input "
+                   "(MADEIRA_ZINK_INT_ATTRIBS=0 turns this off)",
+                   loc, out[i].format, format, is_signed ? "int" : "uint");
+      }
+      out[i].format = format;
+      changed = true;
+   }
+   return changed ? out : state->attribs;
+}
 
