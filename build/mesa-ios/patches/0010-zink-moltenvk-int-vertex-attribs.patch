diff --git a/src/gallium/drivers/zink/zink_compiler.c b/src/gallium/drivers/zink/zink_compiler.c
index aeb001f..9005472 100644
--- a/src/gallium/drivers/zink/zink_compiler.c
+++ b/src/gallium/drivers/zink/zink_compiler.c
@@ -6564,6 +6564,27 @@ zink_shader_init(struct zink_screen *screen, struct zink_shader *zs)
    optimize_nir(nir, NULL, true);
    prune_io(nir);
 
+   /* Madeira: remember which vertex inputs the shader reads as integers, so
+    * the pipeline can give Metal an integer vertex format for them
+    * (zink_pipeline.c, MADEIRA_ZINK_INT_ATTRIBS).
+    */
+   if (nir->info.stage == MESA_SHADER_VERTEX) {
+      nir_foreach_variable_with_modes(var, nir, nir_var_shader_in) {
+         const struct glsl_type *type = glsl_without_array_or_matrix(var->type);
+         const enum glsl_base_type base = glsl_get_base_type(type);
+         const bool is_int = base == GLSL_TYPE_INT || base == GLSL_TYPE_INT16 || base == GLSL_TYPE_INT8;
+         const bool is_uint = base == GLSL_TYPE_UINT || base == GLSL_TYPE_UINT16 || base == GLSL_TYPE_UINT8;
+         if ((!is_int && !is_uint) || var->data.driver_location >= 32)
+            continue;
+         const unsigned slots = MAX2(glsl_count_attribute_slots(var->type, true), 1);
+         const uint32_t bits = BITFIELD_RANGE(var->data.driver_location, MIN2(slots, 32 - var->data.driver_location));
+         if (is_int)
+            zs->madeira_vs_int_inputs |= bits;
+         else
+            zs->madeira_vs_uint_inputs |= bits;
+      }
+   }
+
    if (nir->info.stage == MESA_SHADER_KERNEL) {
       NIR_PASS_V(nir, type_images);
    }
