diff --git a/src/kosmickrisp/vulkan/kk_query_pool.h b/src/kosmickrisp/vulkan/kk_query_pool.h
index 2fe4c76..179144c 100644
--- a/src/kosmickrisp/vulkan/kk_query_pool.h
+++ b/src/kosmickrisp/vulkan/kk_query_pool.h
@@ -24,6 +24,13 @@ struct kk_ts_state {
     * sampled into this heap and later resolved into `bo` (see kk_query_pool.c).
     * NULL for non-timestamp pools. */
    mtl_counter_heap *heap;
+   /* Madeira: iOS GPUs cap one counter heap at 4096 entries ("Requested Heap
+    * size is too large (requested 8192 max is 4096)"), so a larger pool is
+    * backed by several heaps of `heap_chunk` entries each. `heap` stays
+    * heaps[0]. Query q lives in heaps[q / heap_chunk] at q % heap_chunk. */
+   mtl_counter_heap **heaps;
+   uint32_t heap_count;
+   uint32_t heap_chunk;
    struct util_dynarray stage_map;
 };
 
