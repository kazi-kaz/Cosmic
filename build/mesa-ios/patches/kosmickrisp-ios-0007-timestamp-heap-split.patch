+      pool->ts.heaps = calloc(heap_count, sizeof(*pool->ts.heaps));
+      if (pool->ts.heaps == NULL) {
          kk_DestroyQueryPool(device, kk_query_pool_to_handle(pool), pAllocator);
-         return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+         return vk_error(dev, VK_ERROR_OUT_OF_HOST_MEMORY);
       }
-      pool->ts.stage_map = UTIL_DYNARRAY_INIT;
+      for (uint32_t h = 0; h < heap_count; ++h) {
+         uint32_t entries = MIN2(pool->ts.heap_chunk,
+                                 MAX2(pool->vk.query_count, 1u) -
+                                    h * pool->ts.heap_chunk);
+         pool->ts.heaps[h] =
+            mtl_new_timestamp_counter_heap(dev->mtl_handle, entries);
+         if (pool->ts.heaps[h] == NULL) {
+            kk_DestroyQueryPool(device, kk_query_pool_to_handle(pool),
+                                pAllocator);
+            return vk_error(dev, VK_ERROR_OUT_OF_DEVICE_MEMORY);
+         }
+         /* Counted as we go so a failed pool releases what it created. */
+         pool->ts.heap_count = h + 1;
+      }
+      pool->ts.heap = pool->ts.heaps[0];
 
       /* set up default mapping for unique queries */
       for (unsigned i = 0; i < pool->vk.query_count; ++i) {
@@ -218,8 +261,9 @@ kk_DestroyQueryPool(VkDevice device, VkQueryPool queryPool,
          kk_query_table_remove(dev, &dev->occlusion_queries, remap_index[i]);
       }
    } else if (kk_pool_is_ts(pool)) {
