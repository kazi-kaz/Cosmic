--- a/src/kosmickrisp/vulkan/kk_query_pool.c
+++ b/src/kosmickrisp/vulkan/kk_query_pool.c
@@ -19,6 +19,32 @@
 
 #include "kosmickrisp/bridge/mtl_bridge.h"
 
+#include <stdlib.h>
+#include <string.h>
+
+/* Madeira: largest timestamp counter heap an iOS GPU accepts (Apple A19 Pro,
+ * iOS 27.2: "requested 8192 max is 4096"). MADEIRA_KK_TS_HEAP_SPLIT=0 restores
+ * the single heap of query_count entries. */
+#define KK_TS_HEAP_MAX_ENTRIES 4096u
+
+static uint32_t
+kk_ts_heap_chunk(uint32_t query_count)
+{
+   const char *e = getenv("MADEIRA_KK_TS_HEAP_SPLIT");
+   if (e && !strcmp(e, "0"))
+      return MAX2(query_count, 1u);
+   return MIN2(MAX2(query_count, 1u), KK_TS_HEAP_MAX_ENTRIES);
+}
+
+/* The counter heap and the index inside it that back timestamp query `query`. */
+static mtl_counter_heap *
+kk_ts_heap_for_query(const struct kk_query_pool *pool, uint32_t query,
+                     uint32_t *index)
+{
+   *index = query % pool->ts.heap_chunk;
+   return pool->ts.heaps[query / pool->ts.heap_chunk];
+}
+
 struct kk_query_report {
    uint64_t value;
 };
@@ -180,13 +206,30 @@ kk_CreateQueryPool(VkDevice device, const VkQueryPoolCreateInfo *pCreateInfo,
    } else if (kk_pool_is_ts(pool)) {
       /* Timestamps are sampled into a Metal counter heap (one entry per query)
